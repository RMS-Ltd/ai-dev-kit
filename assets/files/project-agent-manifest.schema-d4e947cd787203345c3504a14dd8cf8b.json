{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-kit.local/schemas/project-agent-manifest.schema.json",
  "title": "ProjectAgentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "introduction",
    "protocol",
    "taskRouting",
    "tracks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "introduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "thesisPointer", "coordinationContract"],
      "properties": {
        "summary": { "type": "string" },
        "thesisPointer": { "type": "string" },
        "coordinationContract": { "type": "string" }
      }
    },
    "protocol": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/protocolEntry" }
    },
    "taskRouting": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/taskRoutingEntry" }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trackEntry" }
    },
    "canon": {
      "type": "array",
      "items": { "$ref": "#/$defs/canonEntry" }
    },
    "openWork": {
      "type": "array",
      "items": { "$ref": "#/$defs/openWorkEntry" }
    }
  },
  "$defs": {
    "protocolEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule", "sourcePath"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9_-]+$" },
        "rule": { "type": "string" },
        "sourcePath": { "type": "string" }
      }
    },
    "taskRoutingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "keywords", "loadFirst"],
      "properties": {
        "intent": { "type": "string" },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "loadFirst": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "relatedTrack": { "type": "string" }
      }
    },
    "trackEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "entryPath"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "entryPath": { "type": "string" }
      }
    },
    "canonEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "openWorkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "summary", "taskDocPath"],
      "properties": {
        "taskId": { "type": "string" },
        "summary": { "type": "string" },
        "taskDocPath": { "type": "string" },
        "priority": { "type": "string" }
      }
    }
  }
}
